[Unit]
Description=Juvia Server Panel
After=network.target

[Service]
Type=simple
User=juvia
Group=juvia
ExecStart=/usr/bin/juvia
Restart=on-failure
RestartSec=5
Environment=JUVIA_DB=/var/lib/juvia/juvia.db
Environment=JUVIA_LOG=/var/log/juvia/panel.log
Environment=JUVIA_PORT=8080
Environment=JUVIA_SOCKET=/var/run/juvia/agent.sock
Environment=JUVIA_JWT_SECRET=change-me-in-production

[Install]
WantedBy=multi-user.target
